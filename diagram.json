{
  "version": 1,
  "author": "Victor",
  "editor": "wokwi",
  "parts": [
    { 
      "type": "board-esp32-c3-devkitm-1", 
      "id": "esp", 
      "top": 0, 
      "left": 0, 
      "attrs": {} 
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": 40,
      "left": -160,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-led",
      "id": "led_verde",
      "top": -120,
      "left": 20,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-resistor",
      "id": "res_verde",
      "top": -60,
      "left": 20,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led_vermelho",
      "top": -120,
      "left": 100,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-resistor",
      "id": "res_vermelho",
      "top": -60,
      "left": 100,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    
    // Conexões do Display OLED (Barramento I2C) 
    [ "oled1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "oled1:VCC", "esp:3V3.1", "red", [ "v0" ] ],
    [ "oled1:SCL", "esp:9", "green", [ "v0" ] ],
    [ "oled1:SDA", "esp:8", "green", [ "v0" ] ],
    
    // Circuito do LED Verde (Pino 10 -> Resistor -> Anodo -> Catodo -> GND)
    [ "esp:10", "res_verde:1", "green", [ "v0" ] ],
    [ "res_verde:2", "led_verde:A", "green", [ "v0" ] ],
    [ "led_verde:C", "esp:GND.2", "black", [ "v0" ] ],
    
    //  Circuito do LED Vermelho (Pino 7 -> Resistor -> Anodo -> Catodo -> GND)
    [ "esp:7", "res_vermelho:1", "red", [ "v0" ] ],
    [ "res_vermelho:2", "led_vermelho:A", "red", [ "v0" ] ],
    [ "led_vermelho:C", "esp:GND.3", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
